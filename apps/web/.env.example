# sketch2cad auth — optional Supabase configuration
#
# Without these, the app runs in local DEMO mode:
#   - accounts, sessions and "emails" are simulated in your browser
#   - everything is labelled "demo mode" so it's obvious
#   - perfect for previewing the full auth experience offline
#
# Copy this file to `.env` and fill in your project's credentials to
# switch to REAL Supabase Auth (email sign-up/login, Google OAuth,
# reset links, email verification, persistent sessions).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
